# Generate a unique value for each deployment, for example:
# openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-random-secret

# Keep disabled outside explicit demo environments.
SEED_DEMO_DATA=false

# ARQ worker 使用的 Redis 地址；Web 进程不依赖 Redis，可不配置。
REDIS_URL=redis://localhost:6379/0

NGINX_PORT=8080
