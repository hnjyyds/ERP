# 生产/本地容器部署环境变量。复制为 .env 后修改。
AUTH_SECRET_KEY=change-me-to-a-random-64-hex-string
SEED_DEMO_DATA=false

# 对外端口（nginx 托管前端并反代 /api）
NGINX_PORT=8080

# 超级管理员：首次启动创建；已有账号默认保留原密码。
# 忘记密码时把 ADMIN_PASSWORD_RESET 设为 true 重启一次，再改回 false。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Xinpei@2026
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_PASSWORD_RESET=false
